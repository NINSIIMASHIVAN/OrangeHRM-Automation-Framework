<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">

<suite name="OrangeHRM Regression Suite" verbose="1">

    <listeners>
        <listener class-name="com.OrangeHRM.listeners.TestListener"/>
    </listeners>

    <test name="Regression Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.OrangeHRM.test.LoginPageTest"/>
            <class name="com.OrangeHRM.test.HomePageTest"/>
            <class name="com.OrangeHRM.test.AddEmployeeTest"/>
            <class name="com.OrangeHRM.test.ClaimsTest"/>
        </classes>
    </test>

</suite>